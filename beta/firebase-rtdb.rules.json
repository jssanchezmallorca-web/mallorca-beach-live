{
  "rules": {
    ".read": "auth != null && auth.token.email === 'MASTER_EMAIL'",
    "locations": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['label','lat','lng','updatedAt']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('label').isString() && newData.child('label').val().length <= 40"
      }
    }
  }
}
